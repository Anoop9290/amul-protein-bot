# Telegram Bot Token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Your Telegram user ID (get from @userinfobot on Telegram)
ADMIN_USER_ID=123456789

# Default pincode for delivery check
DEFAULT_PINCODE=380001

# Price check interval in hours
PRICE_CHECK_INTERVAL_HOURS=6

# Scrape cache TTL in minutes
SCRAPE_CACHE_TTL_MINUTES=30
